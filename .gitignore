# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Data and feature storage (symlinked)
data/
features/

# Binary checkpoints and large datasets/dumps
*.ckpt
*.pt
*.pth
*.bin
*.npz
*.npy
*.tar
*.tar.gz
*.zip
*.jsonl

# Exclude smoke tests and non-experiment runs
experiments/dq_cgp_semantic_generalization/runs/smoke_test/
/runs/
/results/
/outputs/
/checkpoints/

# Keep reports and json metrics
!experiments/dq_cgp_semantic_generalization/reports/*.json
!experiments/dq_cgp_semantic_generalization/reports/*.md

# Keep experiment run logs and metrics
!experiments/dq_cgp_semantic_generalization/runs/**/*.log
!experiments/dq_cgp_semantic_generalization/runs/**/*.json
!experiments/dq_cgp_semantic_generalization/runs/**/status.txt

# Sensitive credentials
*token*.txt
.env

# Editor & OS artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
.pytest_cache/
.ipynb_checkpoints/
